{
  "version": "0.2.0",
  "configurations": [
    {
      // Attaches to the Flutter app `serverpod start` spawns. Don't
      // launch second instance here - it would race for port.
      "name": "baktaz_flutter",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/baktaz_server/.dart_tool/serverpod/flutter-vm-service-info-baktaz.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "baktaz_server",
      "type": "dart",
      "request": "attach",
      "vmServiceInfoFile": "${workspaceFolder}/baktaz_server/.dart_tool/serverpod/vm-service-info.json",
      "preLaunchTask": "serverpod_start",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "[Flutter][Debug] Launch development",
      "request": "launch",
      "type": "dart",
      "program": "baktaz_flutter/lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main.dart",
        "--dart-define-from-file",
        "assets/env/.env.development"
      ]
    },
    {
      "name": "[Flutter][Profile] Launch development",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "baktaz_flutter/lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main.dart",
        "--dart-define-from-file",
        "assets/env/.env.development"
      ]
    },
    {
      "name": "[Flutter][Debug] Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "baktaz_flutter/lib/main.dart",
      "args": [
        "--flavor",
        "staging",
        "--target",
        "lib/main.dart",
        "--dart-define-from-file",
        "assets/env/.env.staging"
      ]
    },
    {
      "name": "[Flutter][Debug] Launch production",
      "request": "launch",
      "type": "dart",
      "program": "baktaz_flutter/lib/main.dart",
      "args": [
        "--flavor",
        "production",
        "--target",
        "lib/main.dart",
        "--dart-define-from-file",
        "assets/env/.env.production"
      ]
    },
    {
      "name": "[Admin][Web][Debug] Launch development",
      "request": "launch",
      "type": "dart",
      "program": "paxa_admin/lib/main.dart",
      "args": [
        "--dart-define-from-file",
        "assets/env/.env.development",
        "--target",
        "lib/main.dart",
        "--web-browser-flag",
        "--disable-web-security"
      ]
    },
    {
      "name": "[Admin][Web][Debug] Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "paxa_admin/lib/main.dart",
      "args": [
        "--dart-define-from-file",
        "assets/env/.env.staging",
        "--target",
        "lib/main.dart"
      ]
    },
    {
      "name": "[Admin][Web][Debug] Launch production",
      "request": "launch",
      "type": "dart",
      "program": "paxa_admin/lib/main.dart",
      "args": [
        "--dart-define-from-file",
        "assets/env/.env.production",
        "--target",
        "lib/main.dart"
      ]
    },
    {
      "name": "Golden (baktaz_flutter)",
      "request": "launch",
      "type": "dart",
      "program": "baktaz_flutter/lib/main.dart",
      "codeLens": {
        "for": ["run-test", "run-test-file"]
      },
      "args": ["--update-goldens"]
    },
    {
      "name": "Golden (baktaz_admin)",
      "request": "launch",
      "type": "dart",
      "program": "baktaz_admin/lib/main.dart",
      "codeLens": {
        "for": ["run-test", "run-test-file"]
      },
      "args": ["--update-goldens"]
    }
  ],
  "compounds": [
    {
      "name": "baktaz (full stack)",
      "configurations": ["baktaz_server", "baktaz_flutter"],
      // Stopping one session stops both; orphan blocks re-attach.
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ]
}
