{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "[Flutter][Debug] Launch development",
      "request": "launch",
      "type": "dart",
      "program": "paxa_flutter/lib/main.dart",
      "args": ["--flavor", "development", "--target", "lib/main.dart", "--dart-define-from-file", "assets/env/.env.development"]
    },
    {
      "name": "[Flutter][Profile] Launch development",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "paxa_flutter/lib/main.dart",
      "args": ["--flavor", "development", "--target", "lib/main.dart", "--dart-define-from-file", "assets/env/.env.development"]
    },
    {
      "name": "[Flutter][Debug] Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "paxa_flutter/lib/main.dart",
      "args": ["--flavor", "staging", "--target", "lib/main.dart", "--dart-define-from-file", "assets/env/.env.staging"]
    },
    {
      "name": "[Flutter][Debug] Launch production",
      "request": "launch",
      "type": "dart",
      "program": "paxa_flutter/lib/main.dart",
      "args": ["--flavor", "production", "--target", "lib/main.dart", "--dart-define-from-file", "assets/env/.env.production"]
    },
    {
      "name": "[Admin][Web][Debug] Launch development",
      "request": "launch",
      "type": "dart",
      "program": "paxa_admin/lib/main.dart",
      "args": [
        "--dart-define",
        "flavor=development",
        "--target",
        "lib/main.dart",
        "--web-browser-flag",
        "--disable-web-security"
      ]
    },
    {
      "name": "[Admin][Web][Debug] Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "paxa_admin/lib/main.dart",
      "args": ["--dart-define", "flavor=staging", "--target", "lib/main.dart"]
    },
    {
      "name": "[Admin][Web][Debug] Launch production",
      "request": "launch",
      "type": "dart",
      "program": "paxa_admin/lib/main.dart",
      "args": [
        "--dart-define",
        "flavor=production",
        "--target",
        "lib/main.dart"
      ]
    },
    {
      "name": "Golden (paxa_flutter)",
      "request": "launch",
      "type": "dart",
      "program": "paxa_flutter/lib/main.dart",
      "codeLens": {
        "for": ["run-test", "run-test-file"]
      },
      "args": ["--update-goldens"]
    },
    {
      "name": "Golden (paxa_admin)",
      "request": "launch",
      "type": "dart",
      "program": "paxa_admin/lib/main.dart",
      "codeLens": {
        "for": ["run-test", "run-test-file"]
      },
      "args": ["--update-goldens"]
    }
  ]
}
